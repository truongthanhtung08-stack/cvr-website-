# ===== COASTAL LAND — mẫu biến môi trường =====
# Copy file này thành `.env.local` (đã bị .gitignore) và điền giá trị thật.
# Trên Vercel: khai báo các biến này trong Project Settings → Environment Variables.

# --- Supabase (CÔNG KHAI — dùng ở client, chịu RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Chỉ SERVER / Edge Function (KHÔNG đặt prefix NEXT_PUBLIC — tuyệt đối không lộ client) ---
SUPABASE_SERVICE_ROLE_KEY=
CLAUDE_API_KEY=

# --- Thanh toán PayOS (bật thật ở B6 / Giai đoạn 3) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Email & OTP (B1 trở đi) ---
RESEND_API_KEY=
ZALO_OA_TOKEN=
