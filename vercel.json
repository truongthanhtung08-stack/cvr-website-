{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != main ] && exit 0; p=$VERCEL_GIT_PREVIOUS_SHA; if [ -n \"$p\" ] && git cat-file -e \"$p^{commit}\" 2>/dev/null; then git diff --quiet \"$p\" HEAD -- . ':!*.md' ':!docs' ':!supabase'; else exit 1; fi",
  "crons": [
    {
      "path": "/api/hoa-don/nhac-xuat",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/hoa-don/nhac-xuat",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/tin-dang/day-tu-dong",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/thong-bao/dinh-ky",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/tin-dang/het-han",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/gia-chuan/tu-cong-bo",
      "schedule": "1 17 * * *"
    },
    {
      "path": "/api/admin/bao-viec",
      "schedule": "2 * * * *"
    },
    {
      "path": "/api/tin-dang/toa-do",
      "schedule": "20 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/anh/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
